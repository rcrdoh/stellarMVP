							"x-error-code": {
								"$ref": "#/components/headers/ErrorCodeHeader"
							}
						},
						"content": {
							"application/problem+json": {
								"schema": {
									"$ref": "#/components/schemas/Problem"
								}
							}
						}
					}
				},
				"security": [
					{
						"serviceToken": []
					}
				]
			}
		},
		"/v1/items/{itemId}": {
