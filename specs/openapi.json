		"/v1/payment-intents": {
			"post": {
				"operationId": "createPaymentIntent",
				"tags": ["payments"],
				"summary": "Crear intent desde una cotización aprobada",
				"parameters": [
					{
						"name": "x-principal-id",
						"in": "header",
						"required": true,
						"description": "ID del usuario autenticado, afirmado por el BFF interno de confianza.",
						"schema": {
							"type": "string",
							"minLength": 1,
							"maxLength": 128
						}
					},
					{
						"name": "Idempotency-Key",
						"in": "header",
						"required": true,
						"schema": {
							"type": "string",
							"minLength": 8,
							"maxLength": 128
						}
					}
				],
				"requestBody": {
					"required": true,
					"content": {
						"application/json": {
							"schema": {
								"$ref": "#/components/schemas/CreatePaymentIntentRequest"
							}
						}
					}
				},
				"responses": {
					"201": {
						"description": "Intent creado con XDR sin firmar",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/PaymentIntent"
								}
							}
						}
					},
					"401": {
						"description": "Token de servicio ausente o inválido",
						"headers": {
							"x-error-code": {
								"$ref": "#/components/headers/ErrorCodeHeader"
							}
						},
						"content": {
							"application/problem+json": {
								"schema": {
									"$ref": "#/components/schemas/Problem"
								}
							}
						}
					},
					"403": {
						"description": "El principal no puede pagar esta cotización",
						"headers": {
							"x-error-code": {
								"$ref": "#/components/headers/ErrorCodeHeader"
							}
						},
						"content": {
							"application/problem+json": {
								"schema": {
									"$ref": "#/components/schemas/Problem"
								}
							}
						}
					},
					"404": {
						"description": "Cotización aprobada no encontrada",
						"headers": {
							"x-error-code": {
								"$ref": "#/components/headers/ErrorCodeHeader"
							}
						},
						"content": {
							"application/problem+json": {
								"schema": {
									"$ref": "#/components/schemas/Problem"
								}
							}
						}
					},
					"409": {
						"description": "Cotización vencida o idempotencia conflictiva",
						"headers": {
							"x-error-code": {
								"$ref": "#/components/headers/ErrorCodeHeader"
							}
						},
						"content": {
							"application/problem+json": {
								"schema": {
									"$ref": "#/components/schemas/Problem"
								}
							}
						}
					},
					"422": {
						"description": "Solicitud inválida",
						"headers": {
							"x-error-code": {
								"$ref": "#/components/headers/ErrorCodeHeader"
							}
						},
						"content": {
							"application/problem+json": {
								"schema": {
									"$ref": "#/components/schemas/Problem"
								}
							}
						}
					},
					"502": {
						"description": "MongoDB o Stellar no disponible",
						"headers": {
							"x-error-code": {
								"$ref": "#/components/headers/ErrorCodeHeader"
							}
						},
						"content": {
							"application/problem+json": {
								"schema": {
									"$ref": "#/components/schemas/Problem"
								}
							}
						}
					},
					"503": {
						"description": "Pagos deshabilitados",
						"headers": {
							"x-error-code": {
								"$ref": "#/components/headers/ErrorCodeHeader"
							}
						},
						"content": {
							"application/problem+json": {
								"schema": {
									"$ref": "#/components/schemas/Problem"
								}
							}
						}
					},
					"200": {
						"description": "Intent existente devuelto por reintento idempotente",
						"headers": {
							"X-Idempotent-Replay": {
								"schema": {
									"type": "string",
									"const": "true"
								}
							}
						},
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/PaymentIntent"
								}
							}
						}
					}
				},
				"security": [
					{
						"serviceToken": []
					}
				]
			}
		},
		"/v1/payment-intents/{intentId}": {
			"get": {
				"operationId": "getPaymentIntent",
				"tags": ["payments"],
				"summary": "Consultar y conciliar estado del intent",
				"parameters": [
					{
						"name": "x-principal-id",
						"in": "header",
						"required": true,
						"description": "ID del usuario autenticado, afirmado por el BFF interno de confianza.",
						"schema": {
							"type": "string",
							"minLength": 1,
							"maxLength": 128
						}
					},
					{
						"name": "intentId",
						"in": "path",
						"required": true,
						"schema": {
							"type": "string",
							"format": "uuid"
						}
					}
				],
				"responses": {
					"200": {
						"description": "Intent y último estado reconciliado",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/PaymentIntent"
								}
							}
						}
					},
					"401": {
						"description": "Token de servicio ausente o inválido",
						"headers": {
							"x-error-code": {
								"$ref": "#/components/headers/ErrorCodeHeader"
							}
						},
						"content": {
							"application/problem+json": {
								"schema": {
									"$ref": "#/components/schemas/Problem"
								}
							}
						}
					},
					"403": {
						"description": "El principal no puede consultar este intent",
						"headers": {
							"x-error-code": {
								"$ref": "#/components/headers/ErrorCodeHeader"
							}
						},
						"content": {
							"application/problem+json": {
								"schema": {
									"$ref": "#/components/schemas/Problem"
								}
							}
						}
					},
					"404": {
						"description": "Intent no encontrado",
						"headers": {
							"x-error-code": {
								"$ref": "#/components/headers/ErrorCodeHeader"
							}
						},
						"content": {
							"application/problem+json": {
								"schema": {
									"$ref": "#/components/schemas/Problem"
								}
							}
						}
					},
					"409": {
						"description": "Resultado pendiente de conciliación",
						"headers": {
							"x-error-code": {
								"$ref": "#/components/headers/ErrorCodeHeader"
							}
						},
						"content": {
							"application/problem+json": {
								"schema": {
									"$ref": "#/components/schemas/Problem"
								}
							}
						}
					},
					"502": {
						"description": "Stellar no disponible",
						"headers": {
							"x-error-code": {
								"$ref": "#/components/headers/ErrorCodeHeader"
							}
						},
						"content": {
							"application/problem+json": {
								"schema": {
									"$ref": "#/components/schemas/Problem"
								}
							}
						}
					},
					"503": {
						"description": "Pagos deshabilitados",
						"headers": {
							"x-error-code": {
								"$ref": "#/components/headers/ErrorCodeHeader"
							}
						},
						"content": {
							"application/problem+json": {
								"schema": {
									"$ref": "#/components/schemas/Problem"
								}
							}
						}
					}
				},
				"security": [
					{
						"serviceToken": []
					}
				]
			}
		},
		"/v1/payment-intents/{intentId}/submission": {
			"post": {
				"operationId": "submitPaymentIntentTransaction",
				"tags": ["payments"],
				"summary": "Verificar y enviar XDR firmado por la wallet",
				"parameters": [
					{
						"name": "x-principal-id",
						"in": "header",
						"required": true,
						"description": "ID del usuario autenticado, afirmado por el BFF interno de confianza.",
						"schema": {
							"type": "string",
							"minLength": 1,
							"maxLength": 128
						}
					},
					{
						"name": "intentId",
						"in": "path",
						"required": true,
						"schema": {
							"type": "string",
							"format": "uuid"
						}
					}
				],
				"requestBody": {
					"required": true,
					"content": {
						"application/json": {
							"schema": {
								"$ref": "#/components/schemas/SubmitPaymentTransactionRequest"
							}
						}
					}
				},
				"responses": {
					"202": {
						"description": "Transacción enviada; consultar estado hasta conciliación",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/PaymentIntent"
								}
							}
						}
					},
					"200": {
						"description": "Resultado terminal del intento (confirmed o failed)",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/PaymentIntent"
								}
							}
						}
					},
					"401": {
						"description": "Token de servicio ausente o inválido",
						"headers": {
							"x-error-code": {
								"$ref": "#/components/headers/ErrorCodeHeader"
							}
						},
						"content": {
							"application/problem+json": {
								"schema": {
									"$ref": "#/components/schemas/Problem"
								}
							}
						}
					},
					"403": {
						"description": "El principal no puede enviar este intent",
						"headers": {
							"x-error-code": {
								"$ref": "#/components/headers/ErrorCodeHeader"
							}
						},
						"content": {
							"application/problem+json": {
								"schema": {
									"$ref": "#/components/schemas/Problem"
								}
							}
						}
					},
					"404": {
						"description": "Intent no encontrado",
						"headers": {
							"x-error-code": {
								"$ref": "#/components/headers/ErrorCodeHeader"
							}
						},
						"content": {
							"application/problem+json": {
								"schema": {
									"$ref": "#/components/schemas/Problem"
								}
							}
						}
					},
					"409": {
						"description": "XDR inválido, estado incompatible o resultado incierto",
						"headers": {
							"x-error-code": {
								"$ref": "#/components/headers/ErrorCodeHeader"
							}
						},
						"content": {
							"application/problem+json": {
								"schema": {
									"$ref": "#/components/schemas/Problem"
								}
							}
						}
					},
					"422": {
						"description": "Solicitud inválida",
						"headers": {
							"x-error-code": {
								"$ref": "#/components/headers/ErrorCodeHeader"
							}
						},
						"content": {
							"application/problem+json": {
								"schema": {
									"$ref": "#/components/schemas/Problem"
								}
							}
						}
					},
					"502": {
						"description": "Stellar no disponible",
						"headers": {
							"x-error-code": {
								"$ref": "#/components/headers/ErrorCodeHeader"
							}
						},
						"content": {
							"application/problem+json": {
								"schema": {
									"$ref": "#/components/schemas/Problem"
								}
							}
						}
					},
					"503": {
						"description": "Pagos deshabilitados",
						"headers": {
							"x-error-code": {
								"$ref": "#/components/headers/ErrorCodeHeader"
							}
						},
						"content": {
							"application/problem+json": {
								"schema": {
									"$ref": "#/components/schemas/Problem"
								}
							}
						}
					}
				},
				"security": [
					{
						"serviceToken": []
					}
				]
			}
		}
	},
	"components": {
		"headers": {
			"ErrorCodeHeader": {
				"description": "Stable error code. Matches problem.code.",
				"schema": {
					"type": "string",
					"pattern": "^SVC-[A-Z]{3,4}-[0-9]{4}$"
				}
			}
		},
		"schemas": {
			"StellarNetworkStatus": {
				"type": "object",
				"required": ["stellarNetworkConfigured"],
				"properties": {
					"stellarNetworkConfigured": {
						"type": "boolean"
					}
				},
				"additionalProperties": false
			},
			"Problem": {
				"type": "object",
				"required": [
					"type",
					"title",
					"status",
					"code",
					"category",
					"detail_key",
					"behavior",
					"correlation",
					"occurred_at"
				],
				"properties": {
					"type": {
						"type": "string",
						"format": "uri"
					},
					"title": {
						"type": "string"
					},
					"status": {
						"type": "integer",
						"minimum": 400,
						"maximum": 599
					},
					"code": {
						"type": "string",
						"pattern": "^SVC-[A-Z]{3,4}-[0-9]{4}$"
					},
					"category": {
						"enum": [
							"VALIDATION",
							"AUTHN_AUTHZ",
							"DECISION_DENY",
							"STATE_CONFLICT",
							"DEPENDENCY",
							"INDETERMINATE",
							"INTERNAL"
						]
					},
					"detail_key": {
						"type": "string"
					},
					"behavior": {
						"$ref": "#/components/schemas/ErrorBehavior"
					},
					"correlation": {
						"$ref": "#/components/schemas/ErrorCorrelation"
					},
					"occurred_at": {
						"type": "string",
						"format": "date-time"
					}
				},
				"additionalProperties": false
			},
			"CreateItemRequest": {
				"type": "object",
				"required": ["name"],
				"properties": {
					"name": {
						"type": "string",
						"minLength": 1,
						"maxLength": 120
					},
					"metadata": {
						"type": "object",
						"additionalProperties": true,
						"default": {}
					}
				},
				"additionalProperties": false
			},
			"ErrorBehavior": {
				"type": "object",
				"required": [
					"retryable",
					"financial_effect",
					"human_action",
					"agent_hint",
					"retry_after_s"
				],
				"properties": {
					"retryable": {
						"enum": [
							"never",
							"safe_if_idempotent",
							"conditional",
							"after_reconcile"
						]
					},
					"financial_effect": {
						"enum": ["none", "unknown", "possible_partial"]
					},
					"human_action": {
						"enum": ["none", "approve", "step_up", "contact_support"]
					},
					"agent_hint": {
						"enum": [
							"NONE",
							"FIX_AND_RETRY",
							"RETRY_WITH_BACKOFF",
							"REQUEST_HUMAN_APPROVAL",
							"REQUEST_STEP_UP",
							"WAIT_FOR_SETTLEMENT",
							"ABORT_AND_REPORT"
						]
					},
					"retry_after_s": {
						"type": ["integer", "null"],
						"minimum": 0
					}
				},
				"additionalProperties": false
			},
			"ErrorCorrelation": {
				"type": "object",
				"required": ["trace_id"],
				"properties": {
					"trace_id": {
						"type": "string"
					}
				},
				"additionalProperties": false
			},
			"HealthResponse": {
				"type": "object",
				"required": ["status", "service"],
				"properties": {
					"status": {
						"const": "ok"
					},
					"service": {
						"type": "string"
					}
				},
				"additionalProperties": false
			},
			"Item": {
				"type": "object",
				"required": ["id", "name", "metadata", "created_at"],
				"properties": {
					"id": {
						"type": "string",
						"format": "uuid"
					},
					"name": {
						"type": "string"
					},
					"metadata": {
						"type": "object",
						"additionalProperties": true
					},
					"created_at": {
						"type": "string",
						"format": "date-time"
					}
				},
				"additionalProperties": false
			},
			"ReadinessResponse": {
				"type": "object",
				"required": ["status", "service", "details"],
				"properties": {
					"status": {
						"enum": ["ok", "degraded"]
					},
					"service": {
						"type": "string"
					},
					"details": {
						"type": "object",
						"additionalProperties": true
					}
				},
				"additionalProperties": false
			},
			"CreatePaymentIntentRequest": {
				"type": "object",
				"required": ["quoteId"],
				"properties": {
					"quoteId": {
						"type": "string",
						"minLength": 1,
						"maxLength": 128
					}
				},
				"additionalProperties": false
			},
			"SubmitPaymentTransactionRequest": {
				"type": "object",
				"required": ["signedXdr"],
				"properties": {
					"signedXdr": {
						"type": "string",
						"minLength": 1,
						"maxLength": 100000
					}
				},
				"additionalProperties": false
			},
			"PaymentLeg": {
				"type": "object",
				"required": ["purpose", "payTo", "amountAtomic"],
				"properties": {
					"purpose": {
						"type": "string",
						"enum": ["merchant", "platform"]
					},
					"payTo": {
						"type": "string",
						"pattern": "^G[A-Z2-7]{55}$"
					},
					"amountAtomic": {
						"type": "string",
						"pattern": "^[1-9][0-9]*$"
					}
				},
				"additionalProperties": false
			},
			"PaymentIntent": {
				"type": "object",
				"required": [
					"intentId",
					"quoteId",
					"orderId",
					"quoteHash",
					"status",
					"networkPassphrase",
					"payerAddress",
					"assetCode",
					"assetIssuer",
					"assetDecimals",
					"totalAmountAtomic",
					"paymentLegs",
					"expiresAt",
					"unsignedXdr",
					"transactionHash",
					"ledger",
					"createdAt",
					"updatedAt"
				],
				"properties": {
					"intentId": {
						"type": "string",
						"format": "uuid"
					},
					"quoteId": {
						"type": "string"
					},
					"quoteHash": {
						"type": "string",
						"pattern": "^[a-f0-9]{64}$"
					},
					"status": {
						"type": "string",
						"enum": [
							"awaiting_signature",
							"submitting",
							"submitted",
							"confirmed",
							"failed",
							"expired"
						]
					},
					"networkPassphrase": {
						"type": "string"
					},
					"payerAddress": {
						"type": "string",
						"pattern": "^G[A-Z2-7]{55}$"
					},
					"assetCode": {
						"const": "USDC"
					},
					"assetIssuer": {
						"type": "string",
						"pattern": "^G[A-Z2-7]{55}$"
					},
					"assetDecimals": {
						"type": "integer",
						"const": 7
					},
					"totalAmountAtomic": {
						"type": "string",
						"pattern": "^[1-9][0-9]*$"
					},
					"paymentLegs": {
						"type": "array",
						"minItems": 1,
						"maxItems": 2,
						"items": {
							"$ref": "#/components/schemas/PaymentLeg"
						}
					},
					"expiresAt": {
						"type": "string",
						"format": "date-time"
					},
					"unsignedXdr": {
						"type": ["string", "null"]
					},
					"transactionHash": {
						"type": ["string", "null"],
						"pattern": "^[a-f0-9]{64}$"
					},
					"ledger": {
						"type": ["integer", "null"],
						"minimum": 1
					},
					"createdAt": {
						"type": "string",
						"format": "date-time"
					},
					"updatedAt": {
						"type": "string",
						"format": "date-time"
					},
					"memo": {
						"type": "string",
						"maxLength": 28
					},
					"orderId": {
						"type": "string"
					}
				},
				"additionalProperties": false
			}
		},
		"securitySchemes": {
			"serviceToken": {
				"type": "http",
				"scheme": "bearer",
				"description": "Bearer service-to-service token. Required on payment routes and when SERVICE_TOKEN is configured on protected routes."
			}
		}
	}
}
