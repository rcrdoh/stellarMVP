# Frontend image (React ACP x402) for Render.
#
# Serves the SPA shell plus `/main.js` and `/styles.css` from a single Bun
# process and proxies `/v1/*` to `UI_API_TARGET` (the API service on Render).
# Build context: repository root.
FROM oven/bun:1.4.0-slim AS runtime

WORKDIR /app

COPY package.json bun.lock ./
RUN bun install --frozen-lockfile --production

COPY scripts ./scripts
COPY src/react-app ./src/react-app
COPY tsconfig.json ./

ENV NODE_ENV=production \
    APP_ENV=prod \
    HOST=0.0.0.0 \
    PORT=3000

EXPOSE 3000

CMD ["bun", "run", "start:web"]
